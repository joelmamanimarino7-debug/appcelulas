rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && userDoc().rol == 'admin';
    }

    function isLiderM12() {
      return isSignedIn() && userDoc().rol == 'lider_m12';
    }

    function isLider() {
      return isSignedIn() && userDoc().rol == 'lider';
    }

    // Células que la persona lidera personalmente (rol 'lider', o 'lider_m12'
    // si además de supervisar lidera su propia célula).
    function misCelulas() {
      return ('celulaIds' in userDoc()) ? userDoc().celulaIds : [];
    }

    match /usuarios/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin() || (
        isLiderM12() &&
        request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['celulaIds'])
      );
    }

    match /celulas/{celulaId} {
      allow read: if isAdmin()
        || (isLiderM12() && resource.data.liderM12Id == request.auth.uid)
        || (isLider() && resource.data.liderId == request.auth.uid);

      // Un líder M12 puede abrir una célula nueva bajo su propio liderazgo
      // (él mismo como líder y como M12 supervisor).
      allow create: if isAdmin() || (
        isLiderM12() &&
        request.resource.data.liderId == request.auth.uid &&
        request.resource.data.liderM12Id == request.auth.uid
      );
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /informes/{informeId} {
      allow read: if isAdmin()
        || (isLiderM12() && resource.data.liderM12Id == request.auth.uid)
        || (isSignedIn() && resource.data.celulaId in misCelulas());

      allow create: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.liderId == request.auth.uid &&
        request.resource.data.celulaId in misCelulas()
      );

      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.liderId == request.auth.uid &&
        request.resource.data.liderId == request.auth.uid &&
        request.resource.data.celulaId == resource.data.celulaId
      );

      allow delete: if isAdmin();
    }

    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
